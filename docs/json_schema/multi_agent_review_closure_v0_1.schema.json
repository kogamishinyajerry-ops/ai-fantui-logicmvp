{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-harness.local/json_schema/multi_agent_review_closure_v0_1.schema.json",
  "title": "Multi-Agent Review Closure v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "closure_id",
    "status",
    "generated_at",
    "milestone",
    "agent_team",
    "inputs",
    "summary",
    "gates",
    "review_threads",
    "pathspec_package",
    "blockers",
    "risk_notes",
    "artifact_paths"
  ],
  "properties": {
    "$schema": {
      "const": "https://well-harness.local/json_schema/multi_agent_review_closure_v0_1.schema.json"
    },
    "kind": {
      "const": "ai-fantui-multi-agent-review-closure"
    },
    "closure_id": {
      "const": "multi-agent-review-closure-v0.1"
    },
    "status": {
      "enum": ["ready_for_owner_acceptance", "ready_with_warnings", "blocked"]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "claim"],
      "properties": {
        "id": {
          "const": "M30"
        },
        "name": {
          "const": "PR Review Closure Packet"
        },
        "claim": {
          "const": "read_only_latest_head_review_closure_handoff"
        }
      }
    },
    "agent_team": {
      "$ref": "#/$defs/agent_team"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "pr_url", "head_ref_oid", "merge_state"],
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 0
        },
        "pr_url": {
          "type": "string"
        },
        "head_ref_oid": {
          "type": "string"
        },
        "merge_state": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_codex_review_request_found",
        "latest_clean_codex_result_found",
        "latest_clean_codex_result_at",
        "remote_checks_state",
        "current_unresolved_thread_count",
        "owner_fixed_thread_count",
        "covered_prior_codex_thread_count",
        "actionable_thread_count",
        "control_plane",
        "recommended_next_action"
      ],
      "properties": {
        "latest_codex_review_request_found": {
          "type": "boolean"
        },
        "latest_clean_codex_result_found": {
          "type": "boolean"
        },
        "latest_clean_codex_result_at": {
          "type": "string"
        },
        "remote_checks_state": {
          "enum": ["pass", "fail", "pending_or_unknown", "no_checks_reported"]
        },
        "current_unresolved_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "owner_fixed_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_prior_codex_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "actionable_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "control_plane": {
          "const": "repo_github_local_artifacts_only"
        },
        "recommended_next_action": {
          "enum": [
            "project_owner_acceptance_or_merge_when_authorized",
            "fix_current_actionable_review_threads"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_head_review",
        "actionable_threads",
        "pr_mergeability",
        "remote_checks",
        "control_plane_boundary",
        "pathspec_boundary"
      ],
      "properties": {
        "latest_head_review": {
          "$ref": "#/$defs/gate_status"
        },
        "actionable_threads": {
          "$ref": "#/$defs/gate_status"
        },
        "pr_mergeability": {
          "$ref": "#/$defs/gate_status"
        },
        "remote_checks": {
          "$ref": "#/$defs/gate_status"
        },
        "control_plane_boundary": {
          "$ref": "#/$defs/gate_status"
        },
        "pathspec_boundary": {
          "$ref": "#/$defs/gate_status"
        }
      }
    },
    "review_threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_thread"
      }
    },
    "pathspec_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathspecs", "excluded_paths", "stage_command"],
      "properties": {
        "pathspecs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure_json", "closure_markdown", "closure_html"],
      "properties": {
        "closure_json": {
          "type": "string"
        },
        "closure_markdown": {
          "type": "string"
        },
        "closure_html": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "agent_team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "team_size", "active_agents", "retired_role_policy"],
      "properties": {
        "mode": {
          "const": "five_agent_context_cap"
        },
        "team_size": {
          "const": 5
        },
        "active_agents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/agent_team_member"
          }
        },
        "retired_role_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent_team_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "name", "scope"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "enum": [
            "ChiefEngineerOrchestrator",
            "LogicIRRepairAgent",
            "EvidenceValidationAgent",
            "SafetyRequirementsReviewer",
            "PackagingPRReadinessAgent"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate_status": {
      "enum": ["pass", "warning", "fail"]
    },
    "review_thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "is_resolved",
        "is_outdated",
        "latest_author",
        "latest_created_at",
        "latest_commit_oid",
        "classification",
        "actionable",
        "latest_body_excerpt"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "is_resolved": {
          "type": "boolean"
        },
        "is_outdated": {
          "type": "boolean"
        },
        "latest_author": {
          "type": "string"
        },
        "latest_created_at": {
          "type": "string"
        },
        "latest_commit_oid": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "owner_fixed_note",
            "prior_codex_issue_covered_by_latest_clean_review",
            "actionable_codex_thread",
            "resolved_or_outdated",
            "non_actionable_context"
          ]
        },
        "actionable": {
          "type": "boolean"
        },
        "latest_body_excerpt": {
          "type": "string"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "status", "message"],
      "properties": {
        "blocker_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["external_blocker", "local_blocker"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
