{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-harness.local/json_schema/multi_agent_m5_construction_control_plane_v0_1.schema.json",
  "title": "Multi-Agent M5 Construction Control Plane v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "package_id",
    "status",
    "milestone",
    "control_plane_summary",
    "child_packages",
    "queue_snapshot",
    "execution_policy",
    "deterministic_gates",
    "failure_recovery",
    "phase_review_stop_conditions",
    "review_boundaries",
    "aggregate",
    "artifact_paths"
  ],
  "properties": {
    "$schema": {
      "const": "https://well-harness.local/json_schema/multi_agent_m5_construction_control_plane_v0_1.schema.json"
    },
    "kind": {
      "const": "ai-fantui-multi-agent-m5-construction-control-plane"
    },
    "package_id": {
      "const": "multi-agent-m5-construction-control-plane-v0.1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "budget",
        "effort_unit",
        "claim"
      ],
      "properties": {
        "id": {
          "const": "M5"
        },
        "name": {
          "const": "长时间开工控制面"
        },
        "budget": {
          "const": 40
        },
        "effort_unit": {
          "const": "施工队工时"
        },
        "claim": {
          "const": "candidate-only long-running construction control plane"
        }
      }
    },
    "control_plane_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness_status",
        "entrypoint",
        "included_milestones",
        "single_entrypoint"
      ],
      "properties": {
        "readiness_status": {
          "const": "ready_for_long_running_construction"
        },
        "entrypoint": {
          "const": "make multi-agent-construction-control-plane"
        },
        "included_milestones": {
          "type": "array",
          "prefixItems": [
            {
              "const": "M1"
            },
            {
              "const": "M2"
            },
            {
              "const": "M3"
            },
            {
              "const": "M4"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "single_entrypoint": {
          "const": true
        }
      }
    },
    "child_packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m4_external_review_handoff",
        "approved_candidate_task_queue",
        "construction_readiness"
      ],
      "properties": {
        "m4_external_review_handoff": {
          "$ref": "#/$defs/childPackage"
        },
        "approved_candidate_task_queue": {
          "$ref": "#/$defs/childPackage"
        },
        "construction_readiness": {
          "$ref": "#/$defs/childPackage"
        }
      }
    },
    "queue_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id",
        "task_count",
        "passed",
        "preflight_passed",
        "executed_limited",
        "converged",
        "open_findings",
        "ready_for_long_running_development"
      ],
      "properties": {
        "queue_id": {
          "const": "approved-candidate-task-queue-v0.1"
        },
        "task_count": {
          "const": 3
        },
        "passed": {
          "const": 3
        },
        "preflight_passed": {
          "const": 3
        },
        "executed_limited": {
          "const": 3
        },
        "converged": {
          "const": 3
        },
        "open_findings": {
          "type": "array",
          "maxItems": 0
        },
        "ready_for_long_running_development": {
          "const": true
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_only",
        "requires_explicit_approval",
        "restricted_execution",
        "workspace_writes_performed_by_shell",
        "deterministic_gates_after_execution"
      ],
      "properties": {
        "approved_only": {
          "const": true
        },
        "requires_explicit_approval": {
          "const": true
        },
        "restricted_execution": {
          "const": true
        },
        "workspace_writes_performed_by_shell": {
          "const": false
        },
        "deterministic_gates_after_execution": {
          "const": true
        }
      }
    },
    "deterministic_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m4_external_review_handoff",
        "approved_candidate_task_queue",
        "approved_candidate_task_queue_artifact",
        "construction_readiness",
        "failure_recovery_runbook",
        "phase_review_stop_conditions",
        "local_gate_entrypoint"
      ],
      "properties": {
        "m4_external_review_handoff": {
          "const": "pass"
        },
        "approved_candidate_task_queue": {
          "const": "pass"
        },
        "approved_candidate_task_queue_artifact": {
          "const": "pass"
        },
        "construction_readiness": {
          "const": "pass"
        },
        "failure_recovery_runbook": {
          "const": "pass"
        },
        "phase_review_stop_conditions": {
          "const": "pass"
        },
        "local_gate_entrypoint": {
          "const": "pass"
        }
      }
    },
    "failure_recovery": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/recoveryItem"
      }
    },
    "phase_review_stop_conditions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/stopCondition"
      }
    },
    "review_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_effect",
        "certification_claim",
        "controller_truth_modified",
        "ui_layout_modified",
        "restricted_paths"
      ],
      "properties": {
        "truth_effect": {
          "const": "none"
        },
        "certification_claim": {
          "const": "none"
        },
        "controller_truth_modified": {
          "const": false
        },
        "ui_layout_modified": {
          "const": false
        },
        "restricted_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_count",
        "child_package_count",
        "queue_task_count",
        "approved_task_count",
        "active_stop_conditions",
        "open_findings",
        "controller_truth_modified",
        "ui_layout_modified",
        "ready_for_long_running_construction"
      ],
      "properties": {
        "milestone_count": {
          "const": 4
        },
        "child_package_count": {
          "const": 3
        },
        "queue_task_count": {
          "const": 3
        },
        "approved_task_count": {
          "const": 3
        },
        "active_stop_conditions": {
          "type": "array",
          "maxItems": 0
        },
        "open_findings": {
          "type": "array",
          "maxItems": 0
        },
        "controller_truth_modified": {
          "const": false
        },
        "ui_layout_modified": {
          "const": false
        },
        "ready_for_long_running_construction": {
          "const": true
        }
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_plane_package",
        "operator_runbook",
        "m4_external_review_handoff",
        "approved_candidate_task_queue_summary",
        "construction_readiness_packet",
        "project_manager_plan",
        "engineering_system_mvp_doc"
      ],
      "properties": {
        "control_plane_package": {
          "type": "string",
          "minLength": 1
        },
        "operator_runbook": {
          "type": "string",
          "minLength": 1
        },
        "m4_external_review_handoff": {
          "type": "string",
          "minLength": 1
        },
        "approved_candidate_task_queue_summary": {
          "type": "string",
          "minLength": 1
        },
        "construction_readiness_packet": {
          "type": "string",
          "minLength": 1
        },
        "project_manager_plan": {
          "type": "string",
          "minLength": 1
        },
        "engineering_system_mvp_doc": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "childPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "package_id",
        "status",
        "checker_status",
        "path"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "checker_status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recoveryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "action",
        "resume_command",
        "stop_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FR-[A-Z]+-[0-9]{3}$"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resume_command": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stopCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "action",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^STOP-[A-Z-]+$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "const": true
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
