{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-harness.local/json_schema/approved_candidate_task_queue_summary_v0_6.schema.json",
  "title": "Approved Candidate Task Queue Summary v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "status",
    "gate_id",
    "queue_id",
    "task_count",
    "ready_for_long_running_development",
    "queue_order",
    "append_only",
    "items",
    "deterministic_gates",
    "aggregate",
    "artifact_paths"
  ],
  "properties": {
    "$schema": {
      "const": "https://well-harness.local/json_schema/approved_candidate_task_queue_summary_v0_6.schema.json"
    },
    "kind": {
      "const": "ai-fantui-approved-candidate-task-queue-summary"
    },
    "status": {
      "const": "pass"
    },
    "gate_id": {
      "const": "approved-candidate-task-queue-v0-6"
    },
    "queue_id": {
      "const": "approved-candidate-task-queue-v0.6"
    },
    "task_count": {
      "const": 8
    },
    "ready_for_long_running_development": {
      "const": true
    },
    "queue_order": {
      "type": "array",
      "prefixItems": [
        {"const": "queue-safety-priority-repair"},
        {"const": "queue-evidence-simulation-result-repair"},
        {"const": "queue-evidence-test-result-missing-repair"},
        {"const": "queue-requirement-ambiguity-repair"},
        {"const": "queue-safety-undefined-signal-repair"},
        {"const": "queue-evidence-boundary-review-repair"},
        {"const": "queue-evidence-unknown-requirement-repair"},
        {"const": "queue-evidence-ir-trace-unknown-requirement-repair"}
      ],
      "minItems": 8,
      "maxItems": 8
    },
    "append_only": {
      "$ref": "#/$defs/appendOnly"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queueItem"
      },
      "minItems": 8,
      "maxItems": 8
    },
    "deterministic_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m8_fast_construction_gate",
        "append_only_prefix",
        "preflight_readiness",
        "approved_task_shell",
        "child_review_exports",
        "evidence_unknown_trace_repair_slice",
        "local_gate"
      ],
      "properties": {
        "m8_fast_construction_gate": {"const": "pass"},
        "append_only_prefix": {"const": "pass"},
        "preflight_readiness": {"const": "pass"},
        "approved_task_shell": {"const": "pass"},
        "child_review_exports": {"const": "pass"},
        "evidence_unknown_trace_repair_slice": {"const": "pass"},
        "local_gate": {"const": "pass"}
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_summary",
        "prefix_v0_5_summary"
      ],
      "properties": {
        "queue_summary": {"$ref": "#/$defs/nonEmptyString"},
        "prefix_v0_5_summary": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "appendOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_queue_id",
        "previous_task_count",
        "preserved_prefix_count",
        "new_task_count",
        "template_id",
        "appended_record_id"
      ],
      "properties": {
        "previous_queue_id": {
          "const": "approved-candidate-task-queue-v0.5"
        },
        "previous_task_count": {"const": 7},
        "preserved_prefix_count": {"const": 7},
        "new_task_count": {"const": 1},
        "template_id": {
          "const": "approved-candidate-repair-task-template-v0.1"
        },
        "appended_record_id": {
          "const": "RUN-QUEUE-008"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_count",
        "passed",
        "preflight_passed",
        "executed_limited",
        "converged",
        "open_findings",
        "controller_truth_modified",
        "ui_layout_modified",
        "fast_gate_used_for_new_item",
        "appended_record_id"
      ],
      "properties": {
        "task_count": {"const": 8},
        "passed": {"const": 8},
        "preflight_passed": {"const": 8},
        "executed_limited": {"const": 8},
        "converged": {"const": 8},
        "open_findings": {
          "type": "array",
          "maxItems": 0
        },
        "controller_truth_modified": {"const": false},
        "ui_layout_modified": {"const": false},
        "fast_gate_used_for_new_item": {"const": true},
        "appended_record_id": {"const": "RUN-QUEUE-008"}
      }
    },
    "queueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_item_id",
        "slice_id",
        "status",
        "queue_contract",
        "preflight",
        "execution",
        "approved_task_shell",
        "selected_task",
        "boundary",
        "artifact_paths"
      ],
      "properties": {
        "queue_item_id": {"$ref": "#/$defs/nonEmptyString"},
        "slice_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "pass"},
        "queue_contract": {"$ref": "#/$defs/queueContract"},
        "preflight": {"$ref": "#/$defs/preflight"},
        "execution": {"$ref": "#/$defs/execution"},
        "approved_task_shell": {"$ref": "#/$defs/approvedTaskShell"},
        "selected_task": {"$ref": "#/$defs/selectedTask"},
        "boundary": {"$ref": "#/$defs/boundary"},
        "artifact_paths": {"$ref": "#/$defs/childArtifactPaths"}
      }
    },
    "queueContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "source_finding_code",
        "task_class",
        "target_agent",
        "task_type",
        "approval_id",
        "readiness_command",
        "runner_contract"
      ],
      "properties": {
        "template_id": {
          "const": "approved-candidate-repair-task-template-v0.1"
        },
        "source_finding_code": {"$ref": "#/$defs/nonEmptyString"},
        "task_class": {
          "enum": [
            "SafetyRepairTask",
            "EvidenceRepairTask",
            "RequirementRepairTask"
          ]
        },
        "target_agent": {"$ref": "#/$defs/nonEmptyString"},
        "task_type": {"$ref": "#/$defs/nonEmptyString"},
        "approval_id": {"$ref": "#/$defs/nonEmptyString"},
        "readiness_command": {
          "enum": [
            "make multi-agent-construction-readiness",
            "make multi-agent-fast-construction-gate"
          ]
        },
        "runner_contract": {
          "const": "candidate_review_packet_export_v0_1"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "returncode",
        "artifact_paths",
        "stderr"
      ],
      "properties": {
        "command": {
          "enum": [
            "make multi-agent-construction-readiness",
            "make multi-agent-fast-construction-gate"
          ]
        },
        "status": {"const": "pass"},
        "returncode": {"const": 0},
        "readiness_id": {"type": "string"},
        "gate_id": {"type": "string"},
        "ready_for_long_running_development": {"type": "boolean"},
        "ready_for_slice_preflight": {"type": "boolean"},
        "artifact_paths": {"type": "object"},
        "stderr": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "slice_status",
        "reviewer_status",
        "finding_chain_statuses"
      ],
      "properties": {
        "status": {"const": "pass"},
        "slice_status": {"const": "pass"},
        "reviewer_status": {"const": "converged"},
        "finding_chain_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"const": "converged"}
        },
        "reason": {"type": "string"}
      }
    },
    "approvedTaskShell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_status",
        "selected_task_id"
      ],
      "properties": {
        "status": {"const": "executed_limited"},
        "approval_status": {"const": "approved"},
        "selected_task_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "selectedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "target_agent",
        "task_type",
        "approval_status"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/nonEmptyString"},
        "target_agent": {"$ref": "#/$defs/nonEmptyString"},
        "task_type": {"$ref": "#/$defs/nonEmptyString"},
        "approval_status": {"const": "approved"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_effect",
        "controller_truth_modified",
        "ui_layout_modified"
      ],
      "properties": {
        "truth_effect": {"const": "none"},
        "controller_truth_modified": {"const": false},
        "ui_layout_modified": {"const": false}
      }
    },
    "childArtifactPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repaired_candidate_packet",
        "candidate_review_packet",
        "candidate_review_packet_export",
        "repair_loop_result"
      ],
      "properties": {
        "repaired_candidate_packet": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_review_packet": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_review_packet_export": {"$ref": "#/$defs/nonEmptyString"},
        "repair_loop_result": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  },
  "x-well-harness-approved-candidate-task-queue-summary": {
    "schema_version": "0.6",
    "scope": "append-only CI artifact summary for a new approved queue record",
    "previous_queue_id": "approved-candidate-task-queue-v0.5",
    "appended_record_id": "RUN-QUEUE-008",
    "truth_effect": "none",
    "controller_truth_modified": false,
    "fast_gate_for_new_item": "make multi-agent-fast-construction-gate"
  }
}
