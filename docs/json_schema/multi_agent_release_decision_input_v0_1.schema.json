{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-harness.local/json_schema/multi_agent_release_decision_input_v0_1.schema.json",
  "title": "Multi-Agent Release Decision Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "input_id",
    "status",
    "generated_at",
    "milestone",
    "agent_team",
    "inputs",
    "summary",
    "gates",
    "decision_options",
    "decision_boundaries",
    "pathspec_package",
    "blockers",
    "risk_notes",
    "artifact_paths"
  ],
  "properties": {
    "$schema": {
      "const": "https://well-harness.local/json_schema/multi_agent_release_decision_input_v0_1.schema.json"
    },
    "kind": {
      "const": "ai-fantui-multi-agent-release-decision-input"
    },
    "input_id": {
      "const": "multi-agent-release-decision-input-v0.1"
    },
    "status": {
      "enum": [
        "ready_for_owner_decision",
        "ready_for_owner_decision_with_warnings",
        "blocked"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "claim"],
      "properties": {
        "id": {
          "const": "M31"
        },
        "name": {
          "const": "Release Decision Input"
        },
        "claim": {
          "const": "read_only_owner_release_decision_input_from_review_closure"
        }
      }
    },
    "agent_team": {
      "$ref": "#/$defs/agent_team"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_closure_id",
        "review_closure_status",
        "pr_number",
        "pr_url",
        "head_ref_oid",
        "merge_state"
      ],
      "properties": {
        "review_closure_id": {
          "type": "string"
        },
        "review_closure_status": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 0
        },
        "pr_url": {
          "type": "string"
        },
        "head_ref_oid": {
          "type": "string"
        },
        "merge_state": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_clean_codex_result_found",
        "latest_clean_codex_result_at",
        "current_unresolved_thread_count",
        "owner_fixed_thread_count",
        "covered_prior_codex_thread_count",
        "actionable_thread_count",
        "remote_checks_state",
        "control_plane",
        "recommended_owner_action"
      ],
      "properties": {
        "latest_clean_codex_result_found": {
          "type": "boolean"
        },
        "latest_clean_codex_result_at": {
          "type": "string"
        },
        "current_unresolved_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "owner_fixed_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_prior_codex_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "actionable_thread_count": {
          "type": "integer",
          "minimum": 0
        },
        "remote_checks_state": {
          "type": "string"
        },
        "control_plane": {
          "const": "repo_github_local_artifacts_only"
        },
        "recommended_owner_action": {
          "enum": [
            "owner_acceptance_when_authorized",
            "owner_acceptance_or_wait_for_remote_checks",
            "fix_current_actionable_reviews"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_closure",
        "latest_head_review",
        "actionable_reviews",
        "mergeability",
        "remote_checks",
        "control_plane_boundary",
        "owner_authorization_boundary",
        "pathspec_boundary"
      ],
      "properties": {
        "review_closure": {
          "$ref": "#/$defs/gate_status"
        },
        "latest_head_review": {
          "$ref": "#/$defs/gate_status"
        },
        "actionable_reviews": {
          "$ref": "#/$defs/gate_status"
        },
        "mergeability": {
          "$ref": "#/$defs/gate_status"
        },
        "remote_checks": {
          "$ref": "#/$defs/gate_status"
        },
        "control_plane_boundary": {
          "$ref": "#/$defs/gate_status"
        },
        "owner_authorization_boundary": {
          "$ref": "#/$defs/gate_status"
        },
        "pathspec_boundary": {
          "$ref": "#/$defs/gate_status"
        }
      }
    },
    "decision_options": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/decision_option"
      }
    },
    "decision_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_merge",
        "self_approval",
        "resolve_review_threads",
        "notion_control_plane_changes",
        "artifact_cleanup"
      ],
      "properties": {
        "auto_merge": {
          "const": "forbidden"
        },
        "self_approval": {
          "const": "forbidden"
        },
        "resolve_review_threads": {
          "const": "forbidden"
        },
        "notion_control_plane_changes": {
          "const": "out_of_scope"
        },
        "artifact_cleanup": {
          "const": "out_of_scope"
        }
      }
    },
    "pathspec_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathspecs", "excluded_paths", "stage_command"],
      "properties": {
        "pathspecs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_input_json",
        "decision_input_markdown",
        "decision_input_html"
      ],
      "properties": {
        "decision_input_json": {
          "type": "string"
        },
        "decision_input_markdown": {
          "type": "string"
        },
        "decision_input_html": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "agent_team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "team_size", "active_agents", "retired_role_policy"],
      "properties": {
        "mode": {
          "const": "five_agent_context_cap"
        },
        "team_size": {
          "const": 5
        },
        "active_agents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/agent_team_member"
          }
        },
        "retired_role_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent_team_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "name", "scope"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "enum": [
            "ChiefEngineerOrchestrator",
            "LogicIRRepairAgent",
            "EvidenceValidationAgent",
            "SafetyRequirementsReviewer",
            "PackagingPRReadinessAgent"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate_status": {
      "enum": ["pass", "warning", "fail"]
    },
    "decision_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "label",
        "enabled",
        "requires_explicit_authorization",
        "automation_action",
        "rationale"
      ],
      "properties": {
        "option_id": {
          "enum": [
            "owner_acceptance",
            "wait_for_remote_checks",
            "fix_actionable_reviews",
            "merge_when_authorized"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "requires_explicit_authorization": {
          "type": "boolean"
        },
        "automation_action": {
          "enum": ["do_not_merge", "observe_only", "local_fix_only"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "status", "message"],
      "properties": {
        "blocker_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["external_blocker", "local_blocker"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
